@model ErrorViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Something went wrong | Tinotenda Nyakatsari</title>
    <style>
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #14213D; color: #E7ECF5; font-family: system-ui, sans-serif; padding: 24px; }
        a { color: #E2C266; }
        code { font-family: ui-monospace, Consolas, monospace; color: #9FAAC0; }
    </style>
</head>
<body>
    <main>
        <h1>That page didn't load.</h1>
        <p>Something failed on the server. <a href="/">Go back to the portfolio</a>.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p><code>Request ID: @Model.RequestId</code></p>
        }
    </main>
</body>
</html>
